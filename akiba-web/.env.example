# Copy to .env.local for local dev. In production, set these in Vercel's
# project settings (DATABASE_URL is added automatically by the Neon integration).

# Required. Long random string used to sign login tokens.
JWT_SIGNING_KEY=

# Optional locally — leave unset to use the built-in PGlite database in .data/.
DATABASE_URL=

# Optional — defaults to Akiba's Google OAuth client id.
GOOGLE_CLIENT_ID=
