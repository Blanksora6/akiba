<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Akiba.Mobile"
             x:Class="Akiba.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Same palette as the web app (akiba-web/src/styles/theme.css). -->
            <Color x:Key="Ink">#0E1512</Color>
            <Color x:Key="Surface">#17211C</Color>
            <Color x:Key="SurfaceRaised">#1E2B23</Color>
            <Color x:Key="Gold">#C9A227</Color>
            <Color x:Key="Jade">#4FAE8E</Color>
            <Color x:Key="Rust">#C1583D</Color>
            <Color x:Key="Cream">#EDE8DC</Color>
            <Color x:Key="Muted">#8B958E</Color>

            <Style x:Key="SectionTitle" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource Muted}" />
                <Setter Property="TextTransform" Value="Uppercase" />
                <Setter Property="CharacterSpacing" Value="1" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                <Setter Property="Padding" Value="16,12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
